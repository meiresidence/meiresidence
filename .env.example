# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_TOKEN=paste-your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id
# You invent this string; you paste the SAME value in the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=mei-residence-2026-verify
GRAPH_API_VERSION=v21.0

# ---------- Claude (Anthropic API) ----------
ANTHROPIC_API_KEY=paste-your-anthropic-api-key
# Options: claude-sonnet-5 (recommended), claude-haiku-4-5-20251001 (cheaper/faster)
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS is GONE (24 Aug 2026) — the output limit is fixed in
# index.js at 8192 and this variable is ignored. Delete it from Render if it is
# still there. max_tokens is a ceiling, not a spend: you pay for the tokens the
# model actually writes, so a high ceiling on a 3-line WhatsApp reply costs the
# same as a low one. Every incident this agent has had came from that number
# being too small (600 cut a reply off mid tool call and broke the contact).

# ---------- Human handoff ----------
# Hot leads are forwarded here. E.164 digits, no '+'. (Eglent's number example.)
AGENT_WHATSAPP_NUMBER=355672049400

# HOW THE ALERT REACHES HIM (changed 2026-09-17).
#   workflow (default) - the agent writes the handoff fields, tags needs-human,
#                        and the GHL "Specialist Handoff Alert" workflow sends
#                        an approved WhatsApp TEMPLATE. This is the only thing
#                        that reaches WhatsApp outside the 24-hour window.
#   direct             - the old behaviour: the agent messages him itself.
#   both               - tag AND direct message. Two pings per handoff.
HANDOFF_ALERT_MODE=workflow
# Used ONLY when the tag write fails and the workflow therefore cannot fire.
# WhatsApp is deliberately last in that order.
SPECIALIST_FALLBACK_CHANNEL=SMS
# On top of the template, the agent tries ONE free-form WhatsApp message with
# the details a template cannot carry (email, the verbatim client message, the
# wa.me and CRM links). It lands only when Eglent has written to the agent in
# the last 24 hours - a template does NOT re-open that window, only his reply
# to one does - and a refusal is harmless, because the template already
# arrived. Set to off to send the template alone.
HANDOFF_DETAIL_FOLLOWUP=on

# ---------- Cold-lead follow-up ----------
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_HOURS=6
FOLLOWUP_MAX_ATTEMPTS=2
FOLLOWUP_CHECK_MINUTES=30
# For nudging leads AFTER 24h of silence you must use an approved template:
FOLLOWUP_USE_TEMPLATE=false
FOLLOWUP_TEMPLATE_NAME=
FOLLOWUP_TEMPLATE_LANG=sq

# ---------- Google Places ("what's near Mei Residence?") ----------
# Enables the find_places tool: real supermarkets / pharmacies / restaurants /
# ATMs near Qerret with live distance and opening hours. Leave it empty and the
# tool is not offered to the model at all (it then answers from the KB only).
# Google Cloud console -> enable "Places API (New)" -> create an API key ->
# restrict it to the Places API. Billing must be on; the agent caches results
# for 6 hours per query to keep the cost near zero.
GOOGLE_MAPS_API_KEY=

# ---------- Misc ----------
PORT=3000
HISTORY_WINDOW=20
